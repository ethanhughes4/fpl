{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -m fpl *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "WebSearch",
      "WebFetch(domain:premierleague.com)",
      "WebFetch(domain:fantasy.premierleague.com)",
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npm run *)",
      "Bash(npm ci)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm install)"
    ],
    "deny": [
      "Read(.env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_tests.py"
            ],
            "timeout": 510
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "builder",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_tests.py",
              "--always"
            ],
            "timeout": 510
          }
        ]
      }
    ]
  }
}
