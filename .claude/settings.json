{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)"
    ]
  },
  "SubagentStop": [
      {
        "matcher": "builder",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run_tests.py"],
            "timeout": 120
          }
        ]
      }
    ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run_tests.py"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}